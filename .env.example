# IncidentPilot local environment example
# Copy to .env and fill values. Never commit .env.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Control-plane database (SQLite for local dev; use PostgreSQL in real deployments)
DATABASE_URL=sqlite+aiosqlite:///./incidentpilot.db

# LLM (leave LLM_ENABLED=false to use FakeLLMProvider)
LLM_ENABLED=false
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# GitHub Integration (disabled by default)
GITHUB_INTEGRATION_ENABLED=false
GITHUB_TOKEN=
GITHUB_REPO=

# Server-side execution limits
MAX_INVESTIGATION_STEPS=20
MAX_TOOL_CALLS=40
MAX_PATCH_ATTEMPTS=3
RUN_TIMEOUT_SECONDS=900

# Reference environment
REFERENCE_ORDERS_API_URL=http://127.0.0.1:8001
REFERENCE_REPO_PATH=./reference/orders_api
REFERENCE_LOGS_PATH=./reference/orders_api/var/logs

# Sandbox
SANDBOX_ENABLED=false
SANDBOX_IMAGE=python:3.12-slim
SANDBOX_NETWORK=none

# Test-only auto approval (never enable in production demos)
AUTO_APPROVE_FOR_TESTS=false

# MCP live stdio command (optional; offline adapter used in unit tests)
MCP_SERVER_COMMAND=

# OpenTelemetry
OTEL_CONSOLE_EXPORTER=false
OTEL_OTLP_ENDPOINT=

# Reference DB (optional PostgreSQL for query_database_readonly)
REFERENCE_DB_URL=
